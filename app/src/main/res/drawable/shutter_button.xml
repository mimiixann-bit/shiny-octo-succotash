<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item><shape android:shape="oval"><solid android:color="#D90000" /></shape></item>
            <item android:inset="10dp"><shape android:shape="oval"><solid android:color="#09070D" /></shape></item>
            <item android:inset="25dp"><shape android:shape="oval"><solid android:color="#FF2020" /></shape></item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="4dp" android:color="#FFFFFF" /><solid android:color="#09070D" /></shape></item>
            <item android:inset="8dp"><shape android:shape="oval"><solid android:color="#F00000" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="4dp" android:color="#FFFFFF" /><solid android:color="#09070D" /></shape></item>
            <item android:inset="8dp"><shape android:shape="oval"><solid android:color="#FFFFFF" /></shape></item>
        </layer-list>
    </item>
</selector>