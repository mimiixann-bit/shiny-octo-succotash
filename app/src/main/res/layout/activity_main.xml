<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/extraControlsScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/lofiOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView" />

    <HorizontalScrollView
        android:id="@+id/extraControlsScroll"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/black"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/controlsBar">

        <LinearLayout
            android:id="@+id/extraControlsBar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/rounded_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_margin="6dp"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/qualityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Q:50%"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/qualitySeekBar"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:min="10"
                android:max="100"
                android:progress="50" />

            <Button
                android:id="@+id/btnNoiseToggle"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOISE:ON"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:minWidth="0dp"
                android:paddingHorizontal="6dp" />

            <Button
                android:id="@+id/btnDateToggle"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATE:ON"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:minWidth="0dp"
                android:paddingHorizontal="6dp" />

            <Button
                android:id="@+id/btnFilterToggle"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="NORMAL"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:minWidth="0dp"
                android:paddingHorizontal="6dp" />

            <Button
                android:id="@+id/btnPixelToggle"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="PIXEL:ON"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:minWidth="0dp"
                android:paddingHorizontal="6dp" />

            <TextView
                android:id="@+id/pixelResLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="50p"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/pixelResSeekBar"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:min="1"
                android:max="150"
                android:progress="50" />

            <TextView
                android:id="@+id/zoomLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="ZOOM"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/zoomSeekBar"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:min="0"
                android:max="100"
                android:progress="0" />

        </LinearLayout>

    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/controlsBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/rounded_panel"
        android:layout_marginHorizontal="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar">

        <Button
            android:id="@+id/btnModeToggle"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PHOTO"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/fpsSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:min="8"
            android:max="25"
            android:progress="15" />

        <TextView
            android:id="@+id/fpsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15 FPS"
            android:textColor="@color/white"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@color/black"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnFlipCamera"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="FLIP"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btnShutter"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_weight="0"
            android:background="@drawable/shutter_button"
            android:contentDescription="Shutter" />

        <Button
            android:id="@+id/btnFlash"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="FLASH:OFF"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
